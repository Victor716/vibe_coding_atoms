# ---- LLM (本地 Ollama，OpenAI 兼容协议) ----
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5-coder:7b
LLM_STREAM=true
# qwen3 系列需显式关闭思考模式；非 thinking 模型无感
LLM_THINK=false

# ---- 沙箱 ----
SANDBOX_BASE_URL=http://localhost:9000
SANDBOX_PUBLIC_HOST=localhost
SANDBOX_PORT_START=10000
SANDBOX_PORT_END=10100
SANDBOX_IMAGE=nginx:alpine
SANDBOX_FALLBACK_LOCAL=true
# 演示降级开关（也可前端传参覆盖）
SANDBOX_DEFAULT_LEVEL=L0        # L0 / L1 / L2 / L3

# ---- DB ----
DATABASE_URL=sqlite+aiosqlite:///./app.db

# ---- CORS ----
CORS_ORIGINS=http://localhost:3000
